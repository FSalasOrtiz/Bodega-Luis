# Copia este archivo como .env.development, .env.staging o .env.production y completa los valores.
# La configuración web de Firebase NO es secreta (la seguridad está en las reglas de Firestore y en Auth),
# pero no pongas aquí claves de cuentas de servicio ni contraseñas.

# local = datos en el navegador (demostración); firebase = base central (producción)
VITE_DATA_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Región de las Cloud Functions (Santiago)
VITE_FUNCTIONS_REGION=southamerica-west1
# Dominio interno de los correos de Firebase Auth (el usuario solo escribe su nombre de usuario).
# Debe coincidir con AUTH_EMAIL_DOMAIN de las Cloud Functions y del script de instalación.
VITE_AUTH_EMAIL_DOMAIN=usuarios.bodega-lo-valledor.app
# Solo para pruebas locales con Firebase Emulator Suite
VITE_USE_EMULATORS=false
# Solo para pruebas E2E (nunca en producción)
VITE_E2E=false
